#!/usr/bin/env bash
# bootstrap.sh — create the workspace layer (framework Chapter 12) in the CURRENT directory from
# a filled-in workspace.json. Copies every workspace template into place, fills the per-repo
# placeholders (<REPO_n_PATH>, <REPO_n_NAME>, <WORKSPACE_SLUG>, <WORKSPACE_NAME>, <REPO_LIST>) from the manifest,
# and leaves the rest of the <PLACEHOLDERS> for you to finish by hand (it lists them at the end).
#
# Usage:  cp <framework>/templates/workspace/workspace.json.template ./workspace.json
#         edit workspace.json (repos, contracts, delegation)
#         bash <framework>/templates/workspace/bootstrap.sh.template <framework path>
# Idempotent-ish: refuses to overwrite a file that already exists unless FORCE=1.
set -euo pipefail
FW="${1:?usage: bootstrap.sh <path to the framework clone>}"
T="$FW/templates/workspace"
[ -f workspace.json ] || { echo "no workspace.json here — copy and fill $T/workspace.json.template first" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

slug=$(jq -r .name workspace.json)
name=$(jq -r '.display_name // .name' workspace.json)
repo_list=$(jq -r '[.repos[].name] | join(", ")' workspace.json)

put() { # put <template> <destination>
  local src="$T/$1" dst="$2"
  if [ -e "$dst" ] && [ "${FORCE:-0}" != "1" ]; then echo "skip (exists): $dst"; return; fi
  mkdir -p "$(dirname "$dst")"
  sed -e "s#<WORKSPACE_SLUG>#$slug#g" -e "s#<WORKSPACE_NAME>#$name#g" -e "s#<REPO_LIST>#$repo_list#g" "$src" > "$dst"
  echo "wrote $dst"
}

put copilot-instructions.md.template        .github/copilot-instructions.md
put orchestrator-agent.md.template          ".github/agents/$slug-orchestrator.agent.md"
put contract-guardian-agent.md.template     .github/agents/contract-guardian.agent.md
put service-mapper-agent.md.template        .github/agents/service-mapper.agent.md
put cross-repo-contracts.instructions.md.template .github/instructions/cross-repo-contracts.instructions.md
put delegate-skill/SKILL.md.template        .github/skills/delegate/SKILL.md
put sync-repos.sh.template                  scripts/sync-repos.sh
put delegate.sh.template                    scripts/delegate.sh
put SERVICE_MAP.md.template                 docs/ai-context/SERVICE_MAP.md
put CONTRACTS.md.template                   docs/ai-context/CONTRACTS.md
[ -e docs/ai-context/HANDOFF_SCHEMA.md ] || { mkdir -p docs/ai-context; cp "$FW/templates/HANDOFF_SCHEMA.md.template" docs/ai-context/HANDOFF_SCHEMA.md; echo "wrote docs/ai-context/HANDOFF_SCHEMA.md"; }
chmod +x scripts/*.sh

# .gitignore and settings.json are generated from the manifest's repo paths.
{
  echo "# Child repo clones — disposable; workspace.json is the source of truth."
  jq -r '.repos[].path' workspace.json | sed 's#^#/#; s#/*$#/#'
  echo "/.github/handoffs/"; echo "/.github/returns/"; echo ".github-pre-bootstrap-backup/"; echo "/.github/hooks/.state/"
} > .gitignore.new
if [ -e .gitignore ] && [ "${FORCE:-0}" != "1" ]; then echo "skip (exists): .gitignore — see .gitignore.new"; else mv .gitignore.new .gitignore; echo "wrote .gitignore"; fi

# The .code-workspace folder list is generated from the manifest (root folder first).
jq --arg slug "$slug" '{
  "_comment": "Generated by bootstrap.sh from workspace.json. Open this file in VS Code (File → Open Workspace from File). Each folder contributes its own .github/ customizations.",
  folders: ([{name:$slug, path:"."}] + [.repos[] | {name:.name, path:.path}]),
  settings: {"chat.subagents.allowInvocationsFromSubagents": true, "chat.useAgentsMdFile": true}
}' workspace.json > "$slug.code-workspace" && echo "wrote $slug.code-workspace"

# SERVICE_MAP.md rows come from the manifest (owns/orchestrator); evidence column stays for service-mapper.
sm=docs/ai-context/SERVICE_MAP.md
if grep -q "<REPO_1_NAME>" "$sm"; then
  rows=$(jq -r '.repos[] | "| `\(.name)` | `\(.path)` | \(.owns // [] | join(", ")) | — | — | `\(.orchestrator)` | _(service-mapper fills)_ |"' workspace.json)
  awk -v rows="$rows" '/<REPO_[0-9]+_NAME>/ { if (!done) { print rows; done=1 } ; next } { print }' "$sm" > "$sm.tmp" && mv "$sm.tmp" "$sm" && echo "filled $sm rows from workspace.json"
fi

# The orchestrator's VS Code subagent allowlist = the two workspace specialists + every child orchestrator.
orch=".github/agents/$slug-orchestrator.agent.md"
allow=$(jq -r '[.repos[].orchestrator] | map("'"'"'" + . + "'"'"'") | join(", ")' workspace.json)
sed -i.bak "s#^agents: \[.*\]#agents: ['contract-guardian', 'service-mapper', $allow]#" "$orch" && rm -f "$orch.bak" && echo "filled agents: allowlist in $orch"

echo
echo "Remaining placeholders to fill by hand:"
grep -rn "<[A-Z][A-Z_0-9]*>" .github docs "$slug.code-workspace" --exclude-dir=.git 2>/dev/null | grep -v "<REPO_NAME_FRAGMENT>" | sed 's/^/  /' || echo "  (none)"
echo
echo "Next: scripts/sync-repos.sh  →  open $slug.code-workspace in VS Code and pick $slug-orchestrator"
